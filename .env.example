# Copy to .env, then run python scripts/init_secrets.py. Never commit .env.
TRACEMARK_ENV=development
TRACEMARK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRACEMARK_COOKIE_SECURE=false
TRACEMARK_COOKIE_SAMESITE=lax

# Generate three independent random values. Production rejects development defaults.
TRACEMARK_MASTER_KEY=
TRACEMARK_REPORT_KEY=
TRACEMARK_SESSION_PEPPER=

# SQLite metadata only. A persistent private directory is required in production.
TRACEMARK_DATA_ROOT=.data/focused
TRACEMARK_RETENTION_SECONDS=2592000
TRACEMARK_OUTPUT_TTL_SECONDS=900
TRACEMARK_TRANSIENT_MAX_BYTES=134217728

# Upload and processing bounds. Use one Uvicorn worker.
TRACEMARK_MAX_UPLOAD_BYTES=20971520
TRACEMARK_MAX_IMAGE_PIXELS=4000000
TRACEMARK_MAX_IMAGE_DIMENSION=4096
TRACEMARK_PROCESSING_TIMEOUT=30
TRACEMARK_PROCESSING_CONCURRENCY=1
TRACEMARK_PROCESSING_RATE_LIMIT=30
# User-submitted link checks (public URLs only); set false to disable outbound fetching.
TRACEMARK_LINK_CHECKS=true
TRACEMARK_LINK_CHECK_RATE_LIMIT=10
TRACEMARK_LOG_LEVEL=INFO

# Frontend build only; include /api/v1. Defaults to the same-origin proxy.
VITE_API_URL=/api/v1
