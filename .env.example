# Application
TRACEMARK_ENV=development
TRACEMARK_APP_NAME=TraceMark
TRACEMARK_API_PREFIX=/api/v1
TRACEMARK_PUBLIC_ORIGIN=http://localhost:8080
TRACEMARK_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
TRACEMARK_COOKIE_SECURE=false
TRACEMARK_SESSION_TTL_SECONDS=3600
TRACEMARK_SESSION_BACKEND=redis
TRACEMARK_SESSION_PEPPER=
TRACEMARK_MAX_UPLOAD_BYTES=26214400
TRACEMARK_MAX_IMAGE_PIXELS=40000000
TRACEMARK_MASTER_KEY=
TRACEMARK_REPORT_KEY=

# PostgreSQL
POSTGRES_DB=tracemark
POSTGRES_USER=tracemark
POSTGRES_PASSWORD=change-me-for-nonlocal-use
TRACEMARK_DATABASE_URL=postgresql+psycopg://tracemark:change-me-for-nonlocal-use@postgres:5432/tracemark

# Redis and jobs
TRACEMARK_REDIS_URL=redis://redis:6379/0
TRACEMARK_JOB_CONCURRENCY=2

# S3-compatible object storage
MINIO_ROOT_USER=tracemark-local
MINIO_ROOT_PASSWORD=change-me-local-storage
TRACEMARK_STORAGE_BACKEND=minio
TRACEMARK_MINIO_ENDPOINT=minio:9000
TRACEMARK_MINIO_ACCESS_KEY=tracemark-local
TRACEMARK_MINIO_SECRET_KEY=change-me-local-storage
TRACEMARK_S3_REGION=us-east-1
TRACEMARK_S3_BUCKET_ORIGINALS=tracemark-originals
TRACEMARK_S3_BUCKET_OUTPUTS=tracemark-outputs
TRACEMARK_S3_BUCKET_TEMP=tracemark-temp
TRACEMARK_S3_BUCKET_REPORTS=tracemark-reports

# Demonstration account (seed only)
TRACEMARK_DEMO_EMAIL=demo@tracemark.local
TRACEMARK_DEMO_PASSWORD=TraceMark-Demo-Only-2026!

# Scanner
TRACEMARK_SCANNER_ENABLED=true
TRACEMARK_SCANNER_MAX_BYTES=10485760
TRACEMARK_SCANNER_MAX_REDIRECTS=3
TRACEMARK_SCANNER_MAX_CANDIDATES=30
TRACEMARK_SCANNER_TIMEOUT_SECONDS=15
